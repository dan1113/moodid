{
  "name": "moodid",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-23",
  "durable_objects": {
    "bindings": [
      {
        "name": "MOODID_COUNTER",
        "class_name": "MoodidCounter"
      }
    ]
  },
  "migrations": [
    {
      "tag": "moodid-counter-v1",
      "new_sqlite_classes": [
        "MoodidCounter"
      ]
    }
  ],
  "placement": {
    "region": "aws:ap-northeast-2"
  }
}
